---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { site, withBase, toAbsoluteUrl } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  jsonLd?: object;
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  author?: string;
  tags?: string[];
}

const {
  title,
  description = site.description,
  image = '/og.jpg',
  type = 'website',
  canonical,
  noindex = false,
  jsonLd,
  publishedTime,
  modifiedTime,
  author = site.author.name,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${site.shortTitle}` : site.title;
const canonicalUrl = canonical ?? toAbsoluteUrl(Astro.url.pathname);
const absoluteImageUrl = toAbsoluteUrl(image);

const pubIso = publishedTime ? new Date(publishedTime).toISOString() : undefined;
const modIso = modifiedTime ? new Date(modifiedTime).toISOString() : pubIso;
---

<!doctype html>
<html lang="zh-CN" data-theme="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={toAbsoluteUrl('/rss.xml')} />
    <meta name="generator" content={Astro.generator} />

    <!-- 索引抓取控制 (Robots) -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- 搜索引擎站长平台所有权验证 (预留支持) -->
    {site.verification?.google && <meta name="google-site-verification" content={site.verification.google} />}
    {site.verification?.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
    {site.verification?.baidu && <meta name="baidu-site-verification" content={site.verification.baidu} />}
    {site.verification?.shenma && <meta name="shenma-site-verification" content={site.verification.shenma} />}

    <!-- Open Graph (社交与生成式搜索) -->
    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:locale" content="zh_CN" />

    {type === 'article' && (
      <>
        {pubIso && <meta property="article:published_time" content={pubIso} />}
        {modIso && <meta property="article:modified_time" content={modIso} />}
        <meta property="article:author" content={author} />
        {tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />

    <!-- 主题初始化 -->
    <script is:inline>
      const t = localStorage.getItem('theme');
      const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    </script>

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
