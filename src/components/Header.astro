---
import ThemeToggle from './ThemeToggle.astro';
import { site, withBase } from '../data/site';

const navLinks = [
  { href: '/', label: '首页' },
  { href: '/airports', label: '机场库' },
  { href: '/free', label: '免费资源' },
  { href: '/tools', label: '工具箱' },
  { href: '/speedtest', label: '测速实测' },
  { href: '/clients', label: '客户端' },
  { href: '/risk', label: '跑路预警', isAlert: true },
  { href: '/faq', label: '百科FAQ' },
  { href: '/blog', label: '测评专栏' },
].map((l) => ({ ...l, href: withBase(l.href) }));
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href={withBase('/')}>
      <span aria-hidden="true">&gt;</span> {site.shortTitle}
      <span>_</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-links">
        {
          navLinks.map((l) => (
            <li>
              <a href={l.href} aria-current={Astro.url.pathname === l.href ? 'page' : undefined}>
                {l.isAlert && <span class="alert-dot" />}
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <ThemeToggle />
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header :global(.container.nav) {
    max-width: 1240px;
    padding: 0 1rem;
    gap: 0.75rem;
  }

  .brand {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 1.05rem;
  }

  nav {
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  nav::-webkit-scrollbar {
    display: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
  }

  .nav-links li {
    flex-shrink: 0;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.35rem 0.55rem;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap; /* 绝对禁止折行 */
    line-height: 1.2;
    color: var(--muted);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--text-strong);
    background: var(--surface-2);
  }

  .nav-links a[aria-current='page'] {
    color: var(--text-strong);
    font-weight: 600;
    background: var(--surface-2);
  }

  .alert-dot {
    width: 6px;
    height: 6px;
    background: #ef4444;
    border-radius: 50%;
    display: inline-block;
  }
</style>
