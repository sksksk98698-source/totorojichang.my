---
import Layout from '../components/Layout.astro';
import Gallery from '../components/Gallery.astro';
import CircleCarousel from '../components/CircleCarousel.astro';
import { withBase, toAbsoluteUrl } from '../data/site';
import { speedtestedAirports } from '../data/airports';

const speedImages = speedtestedAirports
  .filter((a) => !!a.speedtestImage)
  .map((a) => withBase(a.speedtestImage!));

const unlockPhotos = [
  '/img/unlocks/photo_2026-08-19_12-13-01.jpg',
  '/img/unlocks/photo_2026-08-19_12-13-50.jpg',
  '/img/unlocks/photo_2026-08-19_12-13-58.jpg',
  '/img/unlocks/photo_2026-08-19_12-18-40.jpg',
  '/img/unlocks/photo_2026-08-19_12-20-10.jpg',
  '/img/unlocks/无忧链接.jpg',
].map(withBase);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: '2026 专线测速实测中心 · 17 家主流机场晚高峰真实大图',
  description: '基于真实测试环境与 MAI-TEST-BOT，展示 17 家主流机场真实节点测速与流媒体解锁原图。',
  url: toAbsoluteUrl('/speedtest/'),
};
---

<Layout
  title="专线测速实测中心"
  description="基于真实测试环境与 MAI-TEST-BOT，展示 17 家主流专线机场（光速云、暮光加速、飞猫云等）真实节点测速与流媒体解锁原图。"
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; flex-wrap: wrap; margin-bottom: 2rem;">
        <div style="flex: 1; min-width: 280px;">
          <p class="eyebrow">Network Observatory</p>
          <h1 style="margin: 0.25rem 0 0.75rem;">专线测速实测中心</h1>
          <p class="muted" style="line-height: 1.7; font-size: 1.02rem;">
            本中心收录 17 家主流专线机场真实批次测速图（批次号：<code>speedtest-2026-08-11-cst</code>）与流媒体全区解锁验证截图。拒绝厂商公关美化，客观呈现真实晚高峰带宽、延迟与丢包率。
          </p>
          <div style="display: flex; gap: 1rem; margin-top: 1rem; font-family: var(--font-mono); font-size: 0.82rem;" class="muted">
            <span>● 测试工具：MAI-TEST-BOT 2.0 / Speedtest.net</span>
            <span>● 涵盖品牌：17 家深度实测</span>
          </div>
        </div>

        {speedImages.length > 0 && (
          <div style="align-self: center;">
            <CircleCarousel photos={speedImages.slice(0, 8)} alt="实测节点轮播" />
          </div>
        )}
      </div>

      <!-- 交互画廊：点击全屏 Lightbox + 键盘左右切换 -->
      <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: clamp(1rem, 2vw, 1.75rem); margin-bottom: 3rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <h2 style="font-size: 1.35rem; margin: 0;">📸 17 家机场节点测速实测大图画廊</h2>
          <span class="muted" style="font-size: 0.85rem;">支持全屏查看与键盘左右键切换</span>
        </div>
        <Gallery items={speedImages} title="2026 专线节点测速实测" />
      </div>

      <!-- 17 家实测机场矩阵列表 -->
      <section style="margin-bottom: 3.5rem;">
        <div style="margin-bottom: 1.5rem;">
          <p class="eyebrow">Tested Roster</p>
          <h2 style="margin: 0.2rem 0;">已完成实测的 17 家机场清单与直通</h2>
          <p class="muted" style="font-size: 0.9rem;">
            点击图片可直接放大查看对应机场的完整节点测速面板。
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
          {
            speedtestedAirports.map((a) => (
              <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm);">
                {a.speedtestImage && (
                  <a href={withBase(a.speedtestImage)} target="_blank" rel="noopener" style="display: block; position: relative; height: 160px; background: #000; overflow: hidden;">
                    <img
                      src={withBase(a.speedtestImage)}
                      alt={`${a.name} 节点测速图`}
                      style="width: 100%; height: 100%; object-fit: cover; opacity: 0.85; transition: transform 0.3s;"
                      loading="lazy"
                    />
                    <span style="position: absolute; bottom: 8px; right: 8px; background: rgba(0, 0, 0, 0.75); color: #fff; font-size: 0.72rem; padding: 0.2rem 0.5rem; border-radius: var(--radius-sm); font-family: var(--font-mono);">
                      点击看原图 ↗
                    </span>
                  </a>
                )}

                <div style="padding: 1.25rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
                  <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                      <span class="badge" style="font-size: 0.75rem;">#{a.rank} {a.lineType}</span>
                      <span style="font-family: var(--font-mono); color: var(--accent); font-weight: 700;">{a.minPrice}</span>
                    </div>
                    <h3 style="margin: 0 0 0.4rem; font-size: 1.2rem;">
                      <a href={withBase(`/airports/${a.id}/`)} style="text-decoration: none; color: inherit;">
                        {a.name}
                      </a>
                    </h3>
                    <p class="muted" style="font-size: 0.82rem; line-height: 1.6; margin-bottom: 0.75rem;">
                      {a.summary}
                    </p>
                  </div>

                  <div style="display: flex; gap: 0.5rem; border-top: 1px dashed var(--border); padding-top: 0.75rem; margin-top: 0.5rem;">
                    <a class="btn btn-primary" href={a.affUrl} target="_blank" rel="nofollow sponsored noopener" style="flex: 1; text-align: center; font-size: 0.82rem; padding: 0.4rem 0.6rem;">
                      直达官网 ↗
                    </a>
                    <a class="btn" href={withBase(`/airports/${a.id}/`)} style="font-size: 0.82rem; padding: 0.4rem 0.75rem; border: 1px solid var(--border);">
                      评测详情
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 流媒体与 AI 解锁测试原图画廊 -->
      <section style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: clamp(1.2rem, 2.5vw, 2rem);">
        <p class="eyebrow">Unlock Verification</p>
        <h2 style="margin: 0.2rem 0 0.5rem;">流媒体与 AI 服务解锁验证大图</h2>
        <p class="muted" style="margin-bottom: 1.5rem; font-size: 0.9rem;">
          实测涵盖 Netflix 奈飞全区、Disney+、ChatGPT 原生支持与 YouTube 4K 解锁。
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
          {
            unlockPhotos.map((p, idx) => (
              <a href={p} target="_blank" rel="noopener" style="display: block; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border); background: #000; position: relative;">
                <img src={p} alt={`解锁实测图 ${idx + 1}`} style="width: 100%; height: 210px; object-fit: cover;" loading="lazy" />
                <span style="position: absolute; bottom: 8px; right: 8px; background: rgba(0, 0, 0, 0.75); color: #fff; font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: var(--radius-sm);">
                  原图验证 ↗
                </span>
              </a>
            ))
          }
        </div>
      </section>

    </div>
  </section>
</Layout>
