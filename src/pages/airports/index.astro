---
import Layout from '../../components/Layout.astro';
import { withBase, toAbsoluteUrl } from '../../data/site';
import { airports } from '../../data/airports';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '42 家机场品牌库与专线测速排行榜',
  description: '汇集全网 42 家机场品牌详细信息、IEPL 专线架构、优惠码、套餐价格、流媒体及 ChatGPT 解锁实测。',
  url: toAbsoluteUrl('/airports/'),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: airports.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.name,
      url: toAbsoluteUrl(`/airports/${a.id}/`),
    })),
  },
};
---

<Layout
  title="42 家机场品牌库"
  description="汇集全网 42 家机场品牌详细信息、IEPL/IPLC 专线架构、优惠码、套餐价格、流媒体及 ChatGPT 解锁实测。"
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="container">
      <div style="margin-bottom: 2rem;">
        <p class="eyebrow">Database & Index</p>
        <h1 style="margin: 0.25rem 0 0.75rem;">42 家机场品牌库与评测全景</h1>
        <p class="muted" style="max-width: 70ch; line-height: 1.7;">
          收录 42 家主流及备用机场服务商，包含线路拓扑、自研/第三方客户端支持、实时优惠码及 17 家晚高峰真实测速图。所有外部注册链接均带有赞助属性，本站保持客观中立测试。
        </p>
      </div>

      <!-- 搜索与筛选交互条 -->
      <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 2rem; display: flex; flex-direction: column; gap: 1rem;">
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <input
            type="text"
            id="brand-search"
            placeholder="搜索机场名称、协议（如 VLESS）、线路（如 IEPL）..."
            style="flex: 1; min-width: 240px; padding: 0.6rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg); color: var(--text); font-family: var(--font-sans); font-size: 0.9rem;"
          />
        </div>

        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;" id="filter-tags">
          <span class="muted" style="font-size: 0.85rem; margin-right: 0.5rem;">快速过滤：</span>
          <button class="filter-btn active" data-filter="all">全部 (42)</button>
          <button class="filter-btn" data-filter="top10">前十首选</button>
          <button class="filter-btn" data-filter="speedtest">含实测图 (17)</button>
          <button class="filter-btn" data-filter="iepl">IEPL/IPLC 专线</button>
          <button class="filter-btn" data-filter="budget">高性价比 (&le;¥10/月)</button>
        </div>
      </div>

      <!-- 机场卡片流 -->
      <div class="airports-grid" id="airports-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
        {
          airports.map((a) => (
            <div
              class="airport-card"
              data-name={a.name.toLowerCase()}
              data-protocol={a.protocol.toLowerCase()}
              data-line={a.lineType.toLowerCase()}
              data-top10={a.isTop10 ? 'true' : 'false'}
              data-speedtest={a.hasSpeedtest ? 'true' : 'false'}
              data-price={a.minPrice}
              style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.4rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm); position: relative;"
            >
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                  <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span style="font-family: var(--font-mono); font-size: 0.75rem; background: var(--surface-2); padding: 0.15rem 0.45rem; border-radius: var(--radius-sm); border: 1px solid var(--border); font-weight: 600;">
                      #{a.rank}
                    </span>
                    {a.isFeatured && (
                      <span style="background: #2563eb; color: #fff; font-size: 0.72rem; padding: 0.15rem 0.45rem; border-radius: var(--radius-sm); font-weight: 600;">
                        首推标杆
                      </span>
                    )}
                    {a.hasSpeedtest && (
                      <span style="color: #10b981; font-size: 0.72rem; background: rgba(16, 185, 129, 0.1); padding: 0.15rem 0.45rem; border-radius: var(--radius-sm); border: 1px solid rgba(16, 185, 129, 0.3);">
                        实测图
                      </span>
                    )}
                  </div>
                  <span style="font-family: var(--font-mono); font-weight: 700; color: var(--accent); font-size: 1.05rem;">
                    {a.minPrice}
                  </span>
                </div>

                <h2 style="margin: 0 0 0.5rem; font-size: 1.35rem;">
                  <a href={withBase(`/airports/${a.id}/`)} style="color: inherit; text-decoration: none;">
                    {a.name}
                  </a>
                </h2>

                <p class="muted" style="font-size: 0.86rem; line-height: 1.6; margin-bottom: 1rem; min-height: 44px;">
                  {a.summary}
                </p>

                <div style="background: var(--surface-2); padding: 0.75rem 0.85rem; border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: 0.8rem; display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1.2rem;">
                  <div><span class="muted">线路：</span><strong>{a.lineType}</strong></div>
                  <div><span class="muted">协议：</span>{a.protocol}</div>
                  {a.coupon ? (
                    <div><span class="muted">优惠码：</span><span style="color: var(--accent); font-weight: 700;">{a.coupon}</span></div>
                  ) : (
                    <div><span class="muted">优惠码：</span>暂无或直接折算</div>
                  )}
                </div>
              </div>

              <div style="display: flex; gap: 0.6rem; align-items: center; border-top: 1px dashed var(--border); padding-top: 0.9rem;">
                <a class="btn btn-primary" href={a.affUrl} target="_blank" rel="nofollow sponsored noopener" style="flex: 1; text-align: center; font-size: 0.85rem; padding: 0.45rem 0.8rem;">
                  官网开通 ↗
                </a>
                <a class="btn" href={withBase(`/airports/${a.id}/`)} style="font-size: 0.85rem; padding: 0.45rem 0.85rem; border: 1px solid var(--border);">
                  详情测评
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <div id="no-results" style="display: none; text-align: center; padding: 4rem 1rem;" class="muted">
        <p style="font-size: 1.2rem;">未找到匹配的机场品牌</p>
        <p style="font-size: 0.9rem;">请尝试调整筛选条件或搜索关键词。</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .filter-btn {
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .filter-btn:hover {
    border-color: var(--accent);
  }
  .filter-btn.active {
    background: var(--accent);
    color: var(--on-accent);
    border-color: var(--accent);
  }
</style>

<script>
  const searchInput = document.getElementById('brand-search') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.airport-card'));
  const noResults = document.getElementById('no-results');
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));

  let activeFilter = 'all';

  const filterCards = () => {
    const query = (searchInput?.value || '').trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const name = card.dataset.name || '';
      const protocol = card.dataset.protocol || '';
      const line = card.dataset.line || '';
      const isTop10 = card.dataset.top10 === 'true';
      const hasSpeedtest = card.dataset.speedtest === 'true';
      const priceStr = card.dataset.price || '';

      const matchesSearch = !query || name.includes(query) || protocol.includes(query) || line.includes(query);

      let matchesTag = true;
      if (activeFilter === 'top10') matchesTag = isTop10;
      else if (activeFilter === 'speedtest') matchesTag = hasSpeedtest;
      else if (activeFilter === 'iepl') matchesTag = line.includes('iepl') || line.includes('iplc');
      else if (activeFilter === 'budget') {
        const num = parseFloat(priceStr.replace(/[^0-9.]/g, '')) || 999;
        matchesTag = num <= 10;
      }

      const show = matchesSearch && matchesTag;
      card.style.display = show ? 'flex' : 'none';
      if (show) visibleCount++;
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  };

  searchInput?.addEventListener('input', filterCards);

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = btn.dataset.filter || 'all';
      filterCards();
    });
  });
</script>
